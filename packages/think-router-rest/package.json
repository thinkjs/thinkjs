{
  "name": "think-router-rest",
  "version": "1.0.5",
  "description": "Let think-router recognize REST router easily without custom router.",
  "main": "index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "pnpm run build && pnpm run typecheck && pnpm run lint && node --test --test-concurrency=1 test/index.js test/migration.test.cjs",
    "coverage": "pnpm run build && node --test --test-concurrency=1 --experimental-test-coverage test/index.js test/migration.test.cjs",
    "lint": "eslint index.js test/migration.test.cjs && eslint --config ../../eslint.typescript.config.cjs src/**/*.ts",
    "lint-fix": "pnpm run lint -- --fix",
    "prepack": "npm run build -- --force"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-router-rest"
  },
  "keywords": [
    "thinkjs",
    "think-router",
    "restful"
  ],
  "author": "lizheming <i@imnerd.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thinkjs/think-router-rest/issues"
  },
  "homepage": "https://github.com/thinkjs/think-router-rest#readme",
  "devDependencies": {
    "eslint": "^10.8.0"
  },
  "dependencies": {
    "debug": "^4.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ]
}
