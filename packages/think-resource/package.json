{
  "name": "think-resource",
  "version": "1.0.3",
  "description": "Resource for ThinkJS 3.x ",
  "main": "index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "eslint index.js test/migration.test.cjs && eslint --config ../../eslint.typescript.config.cjs src/**/*.ts",
    "test": "pnpm run build && pnpm run typecheck && pnpm run lint && node --test --test-concurrency=1 test/index.js test/migration.test.cjs",
    "coverage": "pnpm run build && node --test --test-concurrency=1 --experimental-test-coverage test/index.js test/migration.test.cjs",
    "prepack": "npm run build -- --force"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-resource"
  },
  "keywords": [
    "resource",
    "thinkjs",
    "node",
    "static"
  ],
  "author": "xiamingxing",
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thinkjs/think-resource/issues"
  },
  "homepage": "https://github.com/thinkjs/think-resource#readme",
  "dependencies": {
    "debug": "^2.6.3",
    "koa-send": "3.3.0",
    "think-helper": "^1.1.5"
  },
  "devDependencies": {
    "babel-preset-think-node": "^1.0.1",
    "coveralls": "^2.13.0",
    "eslint": "^10.8.0",
    "koa": "^2.2.0",
    "supertest": "^3.0.0",
    "think-helper": "^1.1.5",
    "@types/node": "25.8.0"
  },
  "readmeFilename": "README.md",
  "babel": {
    "presets": [
      "think-node"
    ]
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ]
}
