{
  "name": "think-gc",
  "description": "gc for ThinkJS 3.x",
  "version": "1.0.3",
  "author": {
    "name": "welefen",
    "email": "welefen@gmail.com"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "pnpm run build && pnpm run typecheck && pnpm run lint && node --test --test-concurrency=1 test/index.js test/migration.test.cjs",
    "coverage": "pnpm run build && node --test --test-concurrency=1 --experimental-test-coverage test/index.js test/migration.test.cjs",
    "lint": "eslint index.js test/migration.test.cjs && eslint --config ../../eslint.typescript.config.cjs src/**/*.ts",
    "prepack": "npm run build -- --force"
  },
  "contributors": [
    {
      "name": "welefen",
      "email": "welefen@gmail.com"
    }
  ],
  "main": "index.js",
  "dependencies": {
    "debug": "^2.6.1",
    "think-helper": "^1.1.3",
    "think-ms": "^1.0.1"
  },
  "devDependencies": {
    "babel-core": "^6.22.1",
    "coveralls": "^2.12.0",
    "eslint": "^10.8.0",
    "@types/node": "25.8.0"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-gc"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/thinkjs/think-gc/issues"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ]
}
