{
  "name": "think-store-file",
  "version": "1.1.1",
  "description": "store content use file",
  "main": "index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "eslint index.js test/migration.test.cjs && eslint --config ../../eslint.typescript.config.cjs src/**/*.ts",
    "test": "pnpm run build && pnpm run typecheck && pnpm run lint && node --test --test-concurrency=1 test/index.js test/migration.test.cjs",
    "coverage": "pnpm run build && node --test --test-concurrency=1 --experimental-test-coverage test/index.js test/migration.test.cjs",
    "prepack": "npm run build -- --force"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-store-file"
  },
  "keywords": [
    "think-store-file"
  ],
  "author": {
    "name": "lushijie",
    "email": "lushijie1218@126.com"
  },
  "contributors": [
    {
      "name": "lushijie",
      "email": "lushijie1218@126.com"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thinkjs/think-store-file/issues"
  },
  "homepage": "https://github.com/thinkjs/think-store-file#readme",
  "devDependencies": {
    "coveralls": "~2.11.16",
    "eslint": "^10.8.0",
    "@types/node": "25.8.0",
    "@types/node-legacy": "npm:@types/node@8.10.66"
  },
  "dependencies": {
    "think-debounce": "^1.0.3",
    "think-helper": "^1.1.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ]
}
