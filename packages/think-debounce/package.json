    "test": "npm run build && npm run lint && npm run typecheck && node --test --test-concurrency=1 test/*.js",
    "coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage test/*.js",
    "lint": "eslint index.js test/regression.js test/pack.cjs",
    "lint-fix": "eslint --fix index.js test/regression.js test/pack.cjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/types/tsconfig.json",
    "prepack": "npm run build",
    "test:pack": "node test/pack.cjs"
  },
  "contributors": [
