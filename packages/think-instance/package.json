  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "@types/node": "25.8.0"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-instance"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/thinkjs/think-instance/issues"
  },
  "types": "index.d.ts",
