{
  "name": "think-qs",
  "description": "Use qs module to parse query & post data, support array & object value",
  "version": "1.0.1",
  "author": {
    "name": "welefen",
    "email": "welefen@gmail.com"
  },
  "pre-commit": [
    "test"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "eslint index.js test/migration.test.cjs && eslint --config ../../eslint.typescript.config.cjs src/**/*.ts",
    "test": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test-cov",
    "test-cov": "pnpm run build && node --test --test-concurrency=1 --experimental-test-coverage test/index.js test/migration.test.cjs",
    "prepublish": "pnpm test",
    "prepack": "npm run build -- --force"
  },
  "contributors": [
    {
      "name": "welefen",
      "email": "welefen@gmail.com"
    }
  ],
  "main": "index.js",
  "dependencies": {
    "qs": "^6.5.1"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "pre-commit": "^1.2.2"
  },
  "keywords": [
    "qs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-qs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/thinkjs/think-qs/issues"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ]
}
