{
  "name": "think-crontab",
  "description": "crontab for thinkjs ",
  "version": "1.0.4",
  "author": {
    "name": "welefen",
    "email": "welefen@gmail.com"
  },
  "pre-commit": [
    "test"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "eslint index.js test/migration.test.cjs && eslint --config ../../eslint.typescript.config.cjs src/**/*.ts",
    "lint-fix": "eslint --fix index.js test/migration.test.cjs && eslint --fix --config ../../eslint.typescript.config.cjs src/**/*.ts",
    "test": "pnpm run build && pnpm run typecheck && pnpm run lint && node --test --test-concurrency=1 test/index.js test/migration.test.cjs",
    "coverage": "pnpm run build && node --test --test-concurrency=1 --experimental-test-coverage test/index.js test/migration.test.cjs",
    "prepack": "npm run build -- --force"
  },
  "contributors": [
    {
      "name": "welefen",
      "email": "welefen@gmail.com"
    }
  ],
  "main": "index.js",
  "dependencies": {
    "debug": "^2.6.1",
    "node-schedule": "^1.2.1",
    "think-cluster": "^1.0.0",
    "think-helper": "^1.0.0",
    "think-mock-http": "^1.0.0"
  },
  "devDependencies": {
    "babel-core": "^6.22.1",
    "coveralls": "^2.12.0",
    "eslint": "^10.8.0",
    "mkdirp": "^0.5.1",
    "mock-require": "^2.0.1",
    "rimraf": "^2.6.1",
    "pre-commit": "^1.2.2",
    "@types/node": "25.8.0"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-crontab"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/thinkjs/think-crontab/issues"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ]
}
