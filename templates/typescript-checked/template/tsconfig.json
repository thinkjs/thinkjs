{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "app",
    "types": ["node"],
    "noEmitOnError": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    ".thinkjs/types/**/*.d.ts"
  ]
}
